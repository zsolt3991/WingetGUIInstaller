<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WingetGUIInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
    <AppxDefaultResourceQualifiers>Language=en-US</AppxDefaultResourceQualifiers>
    <Nullable>warnings</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug_Unpackaged' ">
    <XamlDebuggingInformation>True</XamlDebuggingInformation>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="recommended.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.HeaderedControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.DataTable" Version="0.1.260319-build.2547" />
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock" Version="0.1.260319-build.2547" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition=" '$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged'">
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)' != 'Debug_Unpackaged' And '$(Configuration)' != 'Release_Unpackaged'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  
  <!-- Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
       Tools extension to be activated for this project even if the Windows App SDK Nuget
       package has not yet been restored -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnablePreviewMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WingetHelper\WingetHelper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Label="Controls">
    <Page Update="Controls\LoadingIndicator.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\PackageDetailsView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\PackageSourceDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\UpdateDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup Label="Pages">
    <Page Update="Pages\AboutPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\ConsolePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\ImportExportPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\ListPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\HomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\PackageDetailsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\PackageSourcePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\RecommendationsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\SearchPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\UpgradePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\ExcludedPackagesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <Target Name="CopyPriFile" AfterTargets="Build" Condition=" '$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged'">
    <!-- Define variables for clarity. Adjust as necessary. -->
    <PropertyGroup>
      <!-- The default name of the generated .pri file is typically the AssemblyName + .pri -->
      <OriginalPriFile>$(TargetDir)$(AssemblyName).pri</OriginalPriFile>
      <!-- The new desired name for your .pri file -->
      <NewPriFile>$(TargetDir)resources.pri</NewPriFile>
    </PropertyGroup>

    <!-- Use the "Move" task to rename/move the file -->
    <Copy SourceFiles="$(OriginalPriFile)" DestinationFiles="$(NewPriFile)" ContinueOnError="false" />
  </Target>

  <Target Name="CopyPriFilePublish" AfterTargets="Publish" Condition=" '$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged'">
    <!-- Define variables for clarity. Adjust as necessary. -->
    <PropertyGroup>
      <!-- The default name of the generated .pri file is typically the AssemblyName + .pri -->
      <OriginalPriFile>$(PublishDir)$(AssemblyName).pri</OriginalPriFile>
      <!-- The new desired name for your .pri file -->
      <NewPriFile>$(PublishDir)resources.pri</NewPriFile>
    </PropertyGroup>

    <!-- Use the "Copy" task to duplicate the file -->
    <Copy SourceFiles="$(OriginalPriFile)" DestinationFiles="$(NewPriFile)" ContinueOnError="false" />
  </Target>

  <!--
    Workaround for microsoft/WindowsAppSDK#6071: a 2.x unpackaged self-contained build does
    NOT lay out Microsoft.WindowsAppRuntime.Insights.Resource.dll, so AppNotificationManager
    .Register throws 0x8007007E (MOD_NOT_FOUND) and toast notifications break. The explicit
    Microsoft.WindowsAppSDK.Runtime reference alone does not fix it (its targets only do a
    version-consistency check). The DLL ships inside that package's WindowsAppRuntime MSIX,
    so extract just that one entry into the build and publish output. Drop once #6071 is fixed.
    
    Thanks to @hoobio on GitHub from his fix in hoobio/earmark.
  -->
  <PropertyGroup>
    <_RuntimeMsixArch Condition="('$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged') And '$(Platform)' == 'x32'">win10-x32</_RuntimeMsixArch>
    <_RuntimeMsixArch Condition="('$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged') And '$(Platform)' == 'x64'">win10-x64</_RuntimeMsixArch>
    <_RuntimeMsixArch Condition="('$(Configuration)' == 'Debug_Unpackaged' Or '$(Configuration)' == 'Release_Unpackaged') And '$(Platform)' == 'ARM64'">win10-arm64</_RuntimeMsixArch>
  </PropertyGroup>

  <Target Name="_LayoutInsightsResource" AfterTargets="Build;Publish" Condition="'$(WindowsAppSDKSelfContained)' == 'true' and '$(_RuntimeMsixArch)' != '' and '$(PkgMicrosoft_WindowsAppSDK_Runtime)' != ''">
    <ItemGroup>
      <_RuntimeMsix Include="$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\$(_RuntimeMsixArch)\Microsoft.WindowsAppRuntime.*.msix" Exclude="$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\$(_RuntimeMsixArch)\*.DDLM.*.msix;$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\$(_RuntimeMsixArch)\*.Main.*.msix;$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\$(_RuntimeMsixArch)\*.Singleton.*.msix" />
    </ItemGroup>
    <Unzip SourceFiles="@(_RuntimeMsix)" DestinationFolder="$(OutDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" OverwriteReadOnlyFiles="true" Condition="'@(_RuntimeMsix)' != ''" />
    <Unzip SourceFiles="@(_RuntimeMsix)" DestinationFolder="$(PublishDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" OverwriteReadOnlyFiles="true" Condition="'@(_RuntimeMsix)' != '' and '$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
</Project>